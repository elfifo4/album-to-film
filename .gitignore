# This repository is public. It holds code, configuration and documentation only.
# No photographs, videos, music, or data derived from them.
#
# Allow-list: everything at the top level is ignored unless it is named below, so a source folder
# or an output folder can never be committed by accident, whatever it is called.
/*
!/.gitignore
!/README.md
!/LICENSE
!/REBUILD.md
!/ROADMAP.md
!/site.sh
!/Start site.command
!/Stop site.command
!/requirements.txt
!/requirements.lock
!/album_to_film/
!/config/
!/models/
!/.claude/

# Local settings: where your own photographs live
/config/project.json

# Only the launch configuration from .claude
/.claude/*
!/.claude/launch.json

# Third-party model files are downloaded, not stored (see README)
/models/*
!/models/.gitkeep

# Safety net: no media files anywhere
*.jpg
*.jpeg
*.png
*.heic
*.tif
*.tiff
*.webp
*.gif
*.mp4
*.mov
*.m4v
*.mkv
*.avi
*.mp3
*.wav
*.m4a
*.aac
*.flac

__pycache__/
*.pyc
.DS_Store
